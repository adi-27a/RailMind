# Copy to .env. Never commit .env or paste secrets into VITE_* variables.
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Local infrastructure
DATABASE_URL=postgresql://railmind:railmind@localhost:5432/railmind
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000
POSTGRES_DB=railmind
POSTGRES_USER=railmind
POSTGRES_PASSWORD=railmind

# Providers: simulation is the only bundled mode. Authorized integrations must be implemented server-side.
RAILWAY_PROVIDER=simulation
WEATHER_PROVIDER=simulation
RAILWAY_PROVIDER_API_KEY=
WEATHER_PROVIDER_API_KEY=

# Authentication is disabled for the public simulation demo. Production must enable it and use Secret Manager.
AUTH_ENABLED=false
JWT_SECRET=
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=
AUTH_DEMO_ROLE=ADMIN
